{
  "$description": "Houston's First Baptist Church design tokens (W3C Design Tokens Community Group format). Source: Brand Experience Guide v1.0 (May 2024). See brand-guide.md for usage rules.",
  "$extensions": {
    "org.houstonsfirst": {
      "version": "1.0.0",
      "updated": "2026-10-02",
      "owner": "Communications Team",
      "logo": {
        "color": "Black or white only. Never brand colors.",
        "clearspace": "Half the height/width of the logomark on all sides",
        "minHeight": {
          "primary": {
            "in": 0.3,
            "mm": 7.62
          },
          "stacked": {
            "in": 0.75,
            "mm": 19.05
          }
        },
        "files": "assets/logos/ (see assets/README.md)"
      },
      "accessibility": "Digital text/UI follows WCAG 2.x AA (brand-guide.md §5, official 2026-10-02). color.*.textOn = digital pairing; textOnPrint = printed-guide pairing."
    }
  },
